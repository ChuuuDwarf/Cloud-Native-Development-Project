FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
# Use `npm ci` for deterministic installs from package-lock.json + retries to
# survive transient ECONNRESET against the npm registry (which has caused
# the docker-build CI job to flake — see the 2026-05 incident).
RUN npm ci \
  --fetch-retries=5 \
  --fetch-retry-mintimeout=20000 \
  --fetch-retry-maxtimeout=120000

FROM node:20-alpine AS builder
WORKDIR /app
# NEXT_PUBLIC_* env vars are baked into the client bundle at build time.
# Setting only at runtime (via compose `environment:`) has no effect on a
# `next build` image — must come in as a build-arg.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3030
ENV HOSTNAME=0.0.0.0
# Copy build output WITHOUT --chown: files stay owned by root and are only
# world-readable (COPY default mode includes o+r / o+x). The `node` runtime
# user can read+serve them but cannot modify them. This deliberately avoids
# chowning to the runtime user, which would make the copied resources writable
# by `node` and trip docker:S6504 ("write permissions assigned to the copied
# resource"). The Next.js standalone server only reads its own files at runtime.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Run the standalone server as the built-in non-root `node` user (uid 1000)
# shipped by node:20-alpine, satisfying docker:S6471 (no root at runtime).
# Combined with the root-owned, world-readable files above, this gives a
# read-only serve: non-root runtime + non-writable app dir.
USER node

EXPOSE 3030
CMD ["node", "server.js"]