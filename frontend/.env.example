# Frontend environment variables (Next.js)
# Copy this file to `.env.local` and adjust values for your environment.

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Dev-only quick-login helper accounts for the login form.
# Value is a JSON array string of { label, email, password } objects.
# Only read when NODE_ENV !== "production"; if unset/empty/invalid, the
# login form shows no quick-login dropdown. Keep real secrets out of here.
# Copy the line below into .env.local to enable the dropdown in `npm run dev`
# (passwords here match the dev seed data in backend/scripts/seed_dev.py):
# NEXT_PUBLIC_DEMO_ACCOUNTS=[{"label":"系統管理員","email":"admin@example.com","password":"<dev-seed-password>"},{"label":"大主管","email":"director@example.com","password":"<dev-seed-password>"},{"label":"LAB-A主管","email":"supervisor@example.com","password":"<dev-seed-password>"},{"label":"LAB-A人員","email":"engineer@example.com","password":"<dev-seed-password>"},{"label":"廠區使用者","email":"requester@example.com","password":"<dev-seed-password>"}]
